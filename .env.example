# ═══════════════════════════════════════════════════════════════
# FICHIER D'EXEMPLE — copier en .env et remplir les valeurs réelles
# Ce fichier EST versionné. Le fichier .env ne l'est JAMAIS.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────
# DJANGO
# ───────────────────────────────────────────────
DJANGO_SECRET_KEY=changez-moi-en-production-cle-secrete-aleatoire-longue
DJANGO_SETTINGS_MODULE=reconciliation_project.settings.production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ───────────────────────────────────────────────
# BASE DE DONNÉES PostgreSQL
# ───────────────────────────────────────────────
POSTGRES_DB=reconciliation_db
POSTGRES_USER=reconciliation_user
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ───────────────────────────────────────────────
# REDIS (Celery broker)
# ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ───────────────────────────────────────────────
# CELERY BEAT — heure du batch nocturne (format cron)
# ───────────────────────────────────────────────
BATCH_SCHEDULE_HOUR=2
BATCH_SCHEDULE_MINUTE=0

# ───────────────────────────────────────────────
# API-AUTH (service d'authentification LICELI)
# ───────────────────────────────────────────────
API_AUTH_BASE_URL=https://auth.liceli.internal
API_AUTH_SERVICE_ID=rapprochement-module
API_AUTH_SERVICE_KEY=changez-moi-service-key

# ───────────────────────────────────────────────
# API-MOBILE
# ───────────────────────────────────────────────
API_MOBILE_BASE_URL=https://mobile.liceli.internal

# ───────────────────────────────────────────────
# API-CORE (CBS)
# ───────────────────────────────────────────────
API_CORE_BASE_URL=https://core.liceli.internal

# ───────────────────────────────────────────────
# API-PI (Paiement Instantané BCEAO)
# ───────────────────────────────────────────────
API_PI_BASE_URL=https://pi.liceli.internal

# ───────────────────────────────────────────────
# RETRY — gestion des erreurs réseau
# ───────────────────────────────────────────────
API_MAX_RETRIES=3
API_RETRY_WAIT_FIXED=2
API_TIMEOUT_SECONDS=30

# ───────────────────────────────────────────────
# MATCHING — tolérance de date (en jours, défaut J±0)
# ───────────────────────────────────────────────
MATCHING_DATE_TOLERANCE_DAYS=0

# ───────────────────────────────────────────────
# NOTIFICATIONS EMAIL
# ───────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.liceli.internal
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=rapprochement@liceli.com
EMAIL_HOST_PASSWORD=changez-moi-mot-de-passe-smtp
EMAIL_DEFAULT_FROM=rapprochement@liceli.com
NOTIFICATION_RECIPIENTS=responsable-mb@banque.com,backoffice@banque.com

# ───────────────────────────────────────────────
# GHCR — GitHub Container Registry (CI/CD)
# ───────────────────────────────────────────────
REGISTRY_URL=ghcr.io
GHCR_IMAGE_NAME=ghcr.io/VOTRE_ORG/reconciliation
